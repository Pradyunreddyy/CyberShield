# Copy this file to `.env` and fill in real values. NEVER commit the real `.env` file.

# --- General -----------------------------------------------------
ENVIRONMENT=development

# --- Database ------------------------------------------------------
# Local/demo default (no Postgres required):
DATABASE_URL=sqlite:///./dev.db
# Production example (Render Postgres):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# --- Auth / JWT ------------------------------------------------------
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ------------------------------------------------------
# Comma-separated list of allowed frontend origins. Do NOT use "*" in production.
CORS_ORIGINS=http://localhost:5173

# --- AI Service ------------------------------------------------------
# openrouter | anthropic | openai | disabled
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=openrouter/free
AI_REQUEST_TIMEOUT_SECONDS=120

# --- File Uploads ------------------------------------------------------
UPLOAD_MAX_SIZE_BYTES=26214400
UPLOAD_ALLOWED_EXTENSIONS=.zip
UPLOAD_TMP_DIR=/tmp/incident_platform_uploads
MAX_FILES_PER_ARCHIVE=2000
MAX_UNCOMPRESSED_ARCHIVE_BYTES=209715200

# --- Demo seed data ------------------------------------------------------
ENABLE_DEMO_SEED=true
